MINA_DATA_DIR=./data
MINA_DATABASE_PATH=./data/assistant.sqlite
MINA_LLM_PROVIDER=ollama
MINA_OLLAMA_BASE_URL=http://127.0.0.1:11434
MINA_OLLAMA_MODEL=gemma4:e4b 
MINA_OLLAMA_EMBED_MODEL=nomic-embed-text:latest
MINA_OPENAI_API_KEY=
MINA_OPENAI_BASE_URL=https://api.openai.com/v1
MINA_OPENAI_MODEL=gpt-5.5
# Direct Google Gemini alternative: replace the matching entries above.
# MINA_LLM_PROVIDER=openai
# MINA_OPENAI_API_KEY=your_google_api_key
# MINA_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MINA_OPENAI_MODEL=gemini-3.8-flash
# MINA_VISION_PROVIDER=openai
# MINA_OPENAI_VISION_MODEL=gemini-3.8-flash
MINA_OPENROUTER_API_KEY=
MINA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MINA_OPENROUTER_MODEL=openai/gpt-oss-120b:free
MINA_OPENROUTER_MODELS=openai/gpt-oss-120b:free,xiaomi/mimo-v2.5
MINA_OPENROUTER_VISION_MODEL=xiaomi/mimo-v2.5
MINA_OPENROUTER_VISION_MODELS=xiaomi/mimo-v2.5
MINA_OPENROUTER_REFERER=
MINA_OPENROUTER_APP_TITLE=Mina Desktop
MINA_ANTHROPIC_API_KEY=
MINA_ANTHROPIC_BASE_URL=https://api.anthropic.com
MINA_ANTHROPIC_MODEL=claude-opus-4-1-20250805
MINA_ANTHROPIC_MAX_TOKENS=4096
MINA_RECENT_TURN_LIMIT=16
MINA_REQUEST_TIMEOUT_SECONDS=120
MINA_AUDIO_DIR=./data/audio
MINA_MEDIA_DIR=./data/media
MINA_TTS_PROVIDER=orpheus
MINA_TTS_VOICE=tara
MINA_TTS_RATE=0
MINA_ORPHEUS_BASE_URL=http://127.0.0.1:5005
MINA_ORPHEUS_MODEL=orpheus
MINA_ORPHEUS_RESPONSE_FORMAT=wav
MINA_ELEVENLABS_API_KEY=
MINA_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
MINA_ELEVENLABS_MODEL=eleven_multilingual_v2
MINA_ELEVENLABS_VOICE_ID=
MINA_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
MINA_ELEVENLABS_LANGUAGE_CODE=
MINA_SEMANTIC_MEMORY_ENABLED=true
MINA_QDRANT_BASE_URL=http://127.0.0.1:6333
MINA_QDRANT_COLLECTION=mina_memory
MINA_QDRANT_VECTOR_SIZE=768
MINA_QDRANT_TIMEOUT_SECONDS=8
MINA_REFLECTION_ENABLED=true
MINA_REFLECTION_RECENT_MESSAGE_LIMIT=24
MINA_REFLECTION_MAX_CANDIDATES=8
MINA_REFLECTION_MIN_CONFIDENCE=0.55
MINA_VISION_PROVIDER=ollama
MINA_OLLAMA_VISION_MODEL=qwen2.5vl:7b
MINA_OPENAI_VISION_MODEL=gpt-5.5
MINA_VISION_MAX_IMAGE_BYTES=12582912
MINA_WEB_SEARCH_PROVIDER=duckduckgo
MINA_BRAVE_SEARCH_API_KEY=
MINA_WEB_SEARCH_MAX_RESULTS=6
